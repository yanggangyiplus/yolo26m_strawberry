# ───────────────────────────────
# 모델 가중치 (용량 크므로 제외)
# ───────────────────────────────
*.pt
*.pth
*.onnx
*.engine

# ───────────────────────────────
# 데이터셋 이미지/라벨 (용량 크므로 제외)
# 스크립트·configs·README만 포함
# ───────────────────────────────
datasets/raw/
datasets/yolo/
datasets/yolo_3folders/
datasets/yolo_unified/images/
datasets/yolo_unified/_label_*/

# 라벨은 포함 (텍스트라 용량 작음)
# datasets/yolo_unified/labels/ → 포함됨

# ───────────────────────────────
# 학습/추론 결과 (이미지 포함으로 제외)
# ───────────────────────────────
runs/detect/
runs/autolabel_vis/
runs/autolabel_3folders_vis/
runs/autolabel_unified_vis/
runs/compare/

# 학습 로그(.log)는 포함
# runs/strawberry/*.log → 포함됨

# ───────────────────────────────
# 압축 파일
# ───────────────────────────────
*.zip

# ───────────────────────────────
# yolo11m 캐시 (Ultralytics 모델 캐시)
# ───────────────────────────────
yolo11m/

# ───────────────────────────────
# share 폴더 (학습 결과 배포용 — weights 포함)
# 차트 이미지·csv·README는 포함, 가중치만 제외
# ───────────────────────────────
share/*/weights/

# ───────────────────────────────
# 가상환경 / 캐시
# ───────────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo
.ultralytics_cfg/
*.cache

# ───────────────────────────────
# 임시 / IDE
# ───────────────────────────────
.DS_Store
*.swp
*.swo
